# Large, immutable external raw archives are retained locally for auditable
# preprocessing but must not be committed with source code or experiment logs.
data/external/
scripts/__pycache__/
__pycache__/
*.py[cod]

# Validation/training runs are reproducible artifacts, not source files.
output/**/runs/
output/**/batch_runs/
output/_archives/

# Reproducible 800-epoch training artifacts and generated grid registries.
output/scf_gan_800_v1/
output/paper_800_grid_v1/
